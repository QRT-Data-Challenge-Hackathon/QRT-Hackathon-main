{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh repo delete:*)",
      "Bash(kaggle competitions submit:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_main.py\"",
            "timeout": 10,
            "statusMessage": "Checking repo guard (protect main)"
          }
        ]
      },
      {
        "matcher": "mcp__.*__file_upload",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_upload.py\"",
            "timeout": 10,
            "statusMessage": "Checking the upload is reserved in the submissions ledger"
          }
        ]
      }
    ]
  }
}
